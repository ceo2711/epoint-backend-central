# ── App ──────────────────────────────────────────────
APP_NAME="Epoint CRM API"
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
# URL del frontend (portal cliente). Si no se define, se usa el primer origen de CORS_ORIGINS.
FRONTEND_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://epoint:epoint_secret@localhost:5432/epoint_crm
# Opcional (útil con Heroku Postgres remoto desde local):
# DB_CONNECT_TIMEOUT=30
# DB_CONNECT_RETRIES=4
# DB_CONNECT_RETRY_DELAY_SECONDS=2
# DB_POOL_TIMEOUT=60

# ── Auth / JWT ─────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# En desarrollo podés subirlo (ej. 480 = 8 h) para no depender del refresh tan seguido.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
# Cuentas de App Store Review (coma). No exigen 2FA ni cambio de contraseña.
# APP_REVIEW_EMAILS=appreview@epoint.com

# ── Encryption (SSN, credenciales) ───────────────────
# Generar con: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=

# ── Bootstrap admin (Postman / ops) ──────────────────
# Token para POST /api/v1/auth/bootstrap-admin (header X-Bootstrap-Token).
# Vacío = endpoint deshabilitado (404).
# BOOTSTRAP_ADMIN_TOKEN=

# ── Redis / Celery ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Bucketeer / S3 ───────────────────────────────────
# En Heroku se inyectan automáticamente al provisionar Bucketeer.
# En local: usar MinIO (docker-compose) o credenciales Bucketeer de staging.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET_NAME=epoint-crm-dev
S3_ENDPOINT_URL=http://localhost:9000
S3_USE_SSL=false
S3_STORAGE_PREFIX=dev/

# ── Gemini (google-genai) ────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Direcciones (autocompletado / verificación) ──────
# Funciona sin configurar nada: por defecto usa Photon (OpenStreetMap), sin API key.
# Definí esta clave SOLO si querés el upgrade a Google Places (mejor cobertura de portales
# en EE.UU.); requiere habilitar "Places API (New)" en Google Cloud.
GOOGLE_MAPS_API_KEY=

# ── Notificaciones (Fase 6) ──────────────────────────
NOTIFICATIONS_DRY_RUN=true
# Resend — emails transaccionales (bienvenida, reset, link de pago)
RESEND_API_KEY=re_xxxxxxxx
# Cuenta Resend de desarrollo: guaniqued@gmail.com
# Sin dominio verificado: FROM=onboarding@resend.dev; destinatario de prueba = guaniqued@gmail.com
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Epoint Corporation
# Reply-To: OBLIGATORIO para que “Responder” no vaya al FROM de envío.
# mail.tudominio.com es solo para enviar (DKIM); no tiene MX y Gmail rebota.
# Usá la dirección inbound de Resend (Emails → Receiving → Receiving address),
# p.ej. inbox@xxxxxxxx.resend.app, o soporte@inbound.tudominio.com si ya cargaste el MX.
# EMAIL_REPLY_TO=inbox@xxxxxxxx.resend.app
# EMAIL_SUPPORT_URL=https://epointsolution.com/
# Webhook Resend (evento email.received) → POST {BACKEND_PUBLIC_URL}/api/v1/webhooks/resend/inbound
# En local Resend no llega a localhost: usá un túnel o el fixture tests/fixtures/resend_inbound.json
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
# Logo en emails (URL pública). Si está vacío, se usa {BACKEND_PUBLIC_URL}/api/v1/branding/logo
# o {FRONTEND_URL}/epoint-logo.png. En local, definí una URL pública (ej. Heroku) para ver el logo.
# EMAIL_LOGO_URL=https://tu-backend.herokuapp.com/api/v1/branding/logo
# Links de tiendas (email de bienvenida). Vacío = badges visibles sin destino todavía.
# ANDROID_APP_STORE_URL=
# IOS_APP_STORE_URL=
# Sandbox Resend: redirige todos los emails a tu dirección verificada (ej. guaniqued@gmail.com)
# EMAIL_DEV_REDIRECT_TO=guaniqued@gmail.com
# SendGrid — otros eventos vía NotificationService (opcional)
SENDGRID_API_KEY=
# Twilio — WhatsApp de bienvenida (app/services/whatsapp/client_welcome.py)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Plantilla Twilio Content para aprobación de cliente (requerida en sandbox/producción).
# Crear en Twilio Console → Messaging → Content Template Builder con variables:
# {{1}} nombre, {{2}} URL portal, {{3}} email, {{4}} contraseña temporal
# Para probar con la plantilla demo de Twilio, usá su HX... y variables {"1":"...","2":"..."}
TWILIO_WHATSAPP_CLIENT_APPROVED_CONTENT_SID=
# Recordatorios automáticos (0 = solo manual). Corre dentro de uvicorn — no requiere Celery/Redis
ONBOARDING_REMINDER_INTERVAL_MINUTES=0

# Calendly: crear/editar/cancelar reuniones (requiere plan Standard+). false = solo ver/sincronizar
CALENDLY_WRITE_ENABLED=false

# DocuSign: cuenta única de empresa (JWT Grant). Demo: account-d.docusign.com
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# Clave RSA privada PEM; en Heroku usar \\n entre líneas
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_BASE_URI=https://demo.docusign.net/restapi
DOCUSIGN_DEFAULT_TEMPLATE_ID=
DOCUSIGN_DEFAULT_TEMPLATE_ROLE_NAME=Cliente
# Clave HMAC de DocuSign Connect (validación webhook). En dev puede omitirse.
DOCUSIGN_CONNECT_HMAC_KEY=
# URL pública del backend (webhook Connect). Ej. https://tu-backend.herokuapp.com
BACKEND_PUBLIC_URL=

# ── Pagos (Authorize.net / PayPal) ───────────────────
# Guía completa: docs/PAYMENTS_INTEGRATION.md
PAYMENTS_ENABLED=true
# true = simular pagos (botón Pagar aprueba el link sin Authorize/PayPal)
PAYMENT_TEST=false
PAYMENTS_DEFAULT_PROVIDER=authorize
# Authorize.net (Accept Hosted)
AUTHORIZE_API_LOGIN_ID=
AUTHORIZE_TRANSACTION_KEY=
AUTHORIZE_SIGNATURE_KEY=
AUTHORIZE_ENV=sandbox
# Guía completa: docs/PAYPAL_SETUP.md y docs/PAYMENTS_INTEGRATION.md
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
# URL pública del backend (webhooks). Ej. https://tu-backend.herokuapp.com
BACKEND_PUBLIC_URL=
